{
  "name": "customizable-toast-notification",
  "version": "3.19.0",
  "description": "A lightweight, zero-dependency toast notification library with CTA support for modern JavaScript applications with production-grade reliability and comprehensive system  mechanisms",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.esm.mjs",
  "unpkg": "dist/index.umd.js",
  "jsdelivr": "dist/index.umd.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.umd.js"
    },
    "./index.css": {
      "types": "./dist/index.css.d.ts",
      "default": "./dist/index.css"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.esm.mjs",
      "require": "./dist/react.cjs",
      "default": "./dist/react.esm.mjs"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.esm.mjs",
      "require": "./dist/vue.cjs",
      "default": "./dist/vue.esm.mjs"
    },
    "./svelte": {
      "types": "./dist/svelte.d.ts",
      "import": "./dist/svelte.esm.mjs",
      "require": "./dist/svelte.cjs",
      "default": "./dist/svelte.esm.mjs"
    },
    "./solid": {
      "types": "./dist/solid.d.ts",
      "import": "./dist/solid.esm.mjs",
      "require": "./dist/solid.cjs",
      "default": "./dist/solid.esm.mjs"
    },
    "./angular": {
      "types": "./dist/angular.d.ts",
      "import": "./dist/angular.esm.mjs",
      "require": "./dist/angular.cjs",
      "default": "./dist/angular.esm.mjs"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "vue": ">=3.0.0",
    "svelte": ">=3.0.0",
    "solid-js": ">=1.0.0",
    "@angular/core": ">=12.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    },
    "@angular/core": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=14.0.0",
    "npm": ">=6.0.0"
  },
  "browserslist": [
    "> 0.25%",
    "not dead",
    "not ie 11",
    "chrome >= 60",
    "firefox >= 55",
    "safari >= 10.1",
    "edge >= 79",
    "node >= 14"
  ],
  "sideEffects": false,
  "scripts": {
    "dist:clean": "rm -rf dist",
    "build:js": "rollup -c",
    "build:css": "node esbuild-css.mjs",
    "build": "npm run build:js && npm run build:css",
    "build:types:emit": "tsc -p tsconfig.types.json",
    "build:types:bundle": "rollup -c rollup.dts.config.mjs",
    "build:adapter:types": "node scripts/copy-adapter-types.cjs",
    "build:types": "npm run build:types:emit && npm run build:types:bundle && npm run build:adapter:types",
    "zone-build": "npm run dist:clean && npm run build && npm run build:types && du -h dist/*",
    "test:builds": "node scripts/test-build.cjs",
    "test": "npm run ci:test",
    "ci:test": "node tests/logic/logic-verification.test.mjs",
    "test:all": "npm run lint && npm run ci:test && npm run test:builds && npm run test:e2e && npm run test:coverage",
    "test:coverage": "c8 --config c8.config.json node tests/logic/logic-verification.test.mjs",
    "lint": "eslint src",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "version": "node scripts/sync-version.cjs && npm run zone-build",
    "prepublishOnly": "node scripts/sync-version.cjs && npm run zone-build",
    "prepare": "husky"
  },
  "keywords": [
    "javascript",
    "javascript-library",
    "vanilla-js",
    "notification",
    "toast-notification",
    "ui-component",
    "zero-dependency",
    "customizable",
    "framework-agnostic",
    "fallback-system",
    "alert",
    "popup",
    "message",
    "library",
    "npm",
    "umd",
    "esm",
    "cjs",
    "cdn",
    "toast",
    "toast-library",
    "toast-alert",
    "toast-message",
    "custom-notification",
    "popup-notification",
    "frontend",
    "message-popup",
    "npm-library",
    "npm-toast-package",
    "customizable-toast-notification",
    "component",
    "toast-component",
    "notification-component",
    "customisable",
    "customisable-toast-notification",
    "react-component",
    "react-toast",
    "frontend-library",
    "custom-toast",
    "typescript",
    "sanitized-html",
    "xss-safe",
    "accessible",
    "wcag"
  ],
  "publishConfig": {
    "access": "public"
  },
  "author": {
    "name": "Priyanshu Patel",
    "email": "priyanshu.alt191@gmail.com",
    "url": "https://github.com/sammy-cool"
  },
  "license": "Apache-2.0",
  "files": [
    "dist/index.esm.mjs",
    "dist/index.esm.mjs.map",
    "dist/index.umd.js",
    "dist/index.umd.js.map",
    "dist/index.cjs",
    "dist/index.cjs.map",
    "dist/index.d.ts",
    "dist/index.css",
    "dist/index.css.map",
    "dist/index.css.d.ts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@babel/preset-env": "^8.0.0",
    "@commitlint/cli": "^21.2.1",
    "c8": "^12.0.0",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.2",
    "@rollup/plugin-terser": "^1.0.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.0",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "rollup": "^4.49.0",
    "rollup-plugin-dts": "^6.2.3",
    "rollup-plugin-visualizer": "^6.0.3",
    "semantic-release": "^25.0.9",
    "typescript": "^5.9.2"
  },
  "overrides": {
    "handlebars": "^4.7.10",
    "source-map-js": "^1.2.2",
    "serialize-javascript": "^7.1.4",
    "brace-expansion": "^5.0.12",
    "http-cache-semantics": "^4.3.0",
    "ip-address": "^10.7.3",
    "postcss-selector-parser": "^7.1.6",
    "undici": "^6.29.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sammy-cool/customizable-toast-notification.git"
  },
  "bugs": {
    "url": "https://github.com/sammy-cool/customizable-toast-notification/issues"
  },
  "homepage": "https://github.com/sammy-cool/customizable-toast-notification#readme",
  "funding": [
    {
      "type": "individual",
      "url": "https://paypal.me/priyanshupatel1"
    }
  ]
}
