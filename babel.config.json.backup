{
  "presets": [
    ["@babel/preset-env", {
      "targets": {
        "browsers": "> 0.25%, not dead, not ie 11",
        "node": "14.0.0"
      },
      "useBuiltIns": false,
      "modules": false,
      "loose": false,
      "spec": false,
      "debug": false
    }]
  ],
  "exclude": [
    "node_modules/**"
  ]
}
